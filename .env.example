# Salin ke .env lalu isi token sendiri
AUTH_TOKEN=ganti-dengan-token-acak-yang-panjang
# Opsional: kunci khusus admin untuk mengelola akun (login/ganti akun/logout) & reset sandbox
ADMIN_TOKEN=ganti-dengan-kunci-admin-yang-berbeda
AGY_SANDBOX_IDLE_MIN=30
AGY_MODE=acp
AGY_PROMPT_IDLE_MIN=10
AGY_PROMPT_MAX_MIN=60
AGY_QUESTION_TIMEOUT_MIN=30
AGY_MAX_PARALLEL=2
MAX_UPLOAD_FILES=20
MAX_UPLOAD_MB=100
