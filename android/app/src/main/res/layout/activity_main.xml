<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <!-- Backdrop gelap untuk pop-up internal browser bergaya Telegram -->
    <View
        android:id="@+id/inapp_browser_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Lembar pop-up internal browser (sudut atas melengkung, bisa ditarik/minimize) -->
    <LinearLayout
        android:id="@+id/inapp_browser_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:background="@color/app_bg"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inapp_browser_drag_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/inapp_browser_handle"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_browser_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">

                <ImageButton
                    android:id="@+id/inapp_btn_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tutup browser"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_browser_close" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp">

                    <TextView
                        android:id="@+id/inapp_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Memuat…"
                        android:textColor="@color/app_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/inapp_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/app_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/inapp_btn_minimize"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Perkecil browser"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_browser_minimize" />

                <ImageButton
                    android:id="@+id/inapp_btn_more"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu lainnya"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_browser_more" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/inapp_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/app_accent"
            android:visibility="gone" />

        <View
            android:id="@+id/inapp_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26808080" />

        <FrameLayout
            android:id="@+id/inapp_webview_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Tab mini mengambang saat internal browser di-minimize (tap = buka ulang instan tanpa reload) -->
    <LinearLayout
        android:id="@+id/inapp_mini_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="78dp"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/inapp_mini_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Web"
            android:src="@drawable/ic_browser_globe" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="10dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/inapp_mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/inapp_mini_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/app_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/inapp_mini_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tutup tab"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_browser_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_brand_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/app_text"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_brand_logo" />

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/error_title"
            android:textColor="@color/app_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/error_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/error_subtitle"
            android:textColor="@color/app_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_retry_button"
            android:minWidth="148dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
